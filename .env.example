# Copy to .env. Everything is optional: with nothing set, the app runs in demo
# mode (in-memory CRM, template text instead of AI).

# HubSpot private-app access token. Turns on the live CRM sync.
HUBSPOT_TOKEN=

# Anthropic API key. Turns on AI-written homeowner summaries and sales briefs.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Slack (or any) incoming webhook, pinged for hot leads.
NOTIFY_WEBHOOK_URL=

# Route new leads to HubSpot owner IDs by price area. Without this, owners are
# assigned by region from your owner list.
# OWNER_ROUTING={"SE1":"12345","SE2":"12345","SE3":"67890","SE4":"67890"}

# Language for the sales brief: en or sv
SALES_BRIEF_LANGUAGE=en

# PORT=3000
