{
  "name": "home-energy-estimator",
  "version": "1.0.0",
  "description": "Homeowner savings estimator for solar + heat pump + battery, with a full HubSpot lead pipeline behind it.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "setup:hubspot": "node scripts/setup-hubspot.ts",
    "test:flow": "node scripts/test-flow.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
